# Kopiuj do .env dla lokalnego devu (opcjonalnie — application.properties ma
# sensowne defaulty dla docker-compose) albo użyj jako checklisty zmiennych
# do ustawienia w Render (render.yaml) przy deployu.
#
# Wartości poniżej to placeholdery — NIE commituj tu prawdziwych sekretów.

# --- Postgres --- (render.yaml wypełnia to automatycznie z fromDatabase)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=songly
DB_USER=songly
DB_PASSWORD=songly

# --- Redis ---
# Lokalnie: host/port/password (docker-compose redis bez auth).
# Na Render: SPRING_DATA_REDIS_URL (connectionString z Key Value) nadpisuje
# wszystkie trzy poniżej — NIE ustawiaj jej lokalnie, nawet na pusto.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Nagłówki proxy ---
# Zostaw puste/none lokalnie. Na każdym środowisku za proxy (Render) ustaw
# "framework", inaczej rate limiter zobaczy jeden adres IP dla całego ruchu.
# Nie ustawiaj go tam, gdzie przed aplikacją NIE stoi zaufane proxy — wtedy
# X-Forwarded-For jest polem od klienta i obchodzi limit.
FORWARD_HEADERS_STRATEGY=none

# --- JWT (podpisywanie access/refresh tokenów) ---
# Wymagane min. 32 bajty UTF-8 (HMAC-SHA256). Wygeneruj: openssl rand -base64 48
JWT_SECRET=

# --- Szyfrowanie tokenów OAuth Spotify (AES-256-GCM) ---
# Wymagane DOKŁADNIE 32 bajty po zdekodowaniu Base64. Wygeneruj: openssl rand -base64 32
NOW_PLAYING_TOKEN_KEY=

# --- Spotify OAuth app (Spotify Developer Dashboard) ---
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:8080/api/v1/now-playing/spotify/callback
